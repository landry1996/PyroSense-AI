{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Telemetry Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(pyrosense_telemetry_received_total[1m])",
          "legendFormat": "Received/s"
        },
        {
          "expr": "rate(pyrosense_telemetry_rejected_total[1m])",
          "legendFormat": "Rejected/s"
        }
      ]
    },
    {
      "title": "Ingestion Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(pyrosense_telemetry_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(pyrosense_telemetry_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(pyrosense_telemetry_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Rejection Reasons",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(pyrosense_telemetry_rejected_total) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "title": "Devices Reporting",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "count(count by (device_id) (pyrosense_telemetry_received_total))",
          "legendFormat": "Active Devices"
        }
      ]
    },
    {
      "title": "Kafka Producer Metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "rate(kafka_producer_topic_record_send_total{application=\"pyrosense-ingestion-service\"}[5m])",
          "legendFormat": "Records sent/s"
        }
      ]
    },
    {
      "title": "Signal Analysis Processing",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(pyrosense_analysis_events_processed_total[5m])",
          "legendFormat": "Processed/s"
        },
        {
          "expr": "rate(pyrosense_anomalies_detected_total[5m])",
          "legendFormat": "Anomalies/s"
        }
      ]
    },
    {
      "title": "Analysis Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pyrosense_analysis_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["pyrosense", "ingestion", "pipeline"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "PyroSense Ingestion Pipeline",
  "uid": "pyrosense-ingestion"
}
