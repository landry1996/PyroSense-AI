{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "MVP3 - Device Fleet Health",
  "uid": "mvp3-device-fleet-health",
  "tags": ["mvp3", "devices", "fleet"],
  "panels": [
    {
      "title": "Real Device Telemetry Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(pyrosense_mvp3_real_device_telemetry_received_total[1m])",
          "legendFormat": "Received/s"
        }
      ]
    },
    {
      "title": "Signal Quality Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "pyrosense_mvp3_signal_quality_score",
          "legendFormat": "Signal Quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 40 },
              { "color": "green", "value": 70 }
            ]
          }
        }
      }
    },
    {
      "title": "Data Quality Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "pyrosense_mvp3_data_quality_score",
          "legendFormat": "Data Quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Device Offline Duration (max)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pyrosense_mvp3_device_offline_duration_seconds",
          "legendFormat": "Max Offline"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      }
    },
    {
      "title": "Firmware Versions Active",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "pyrosense_mvp3_firmware_version_count",
          "legendFormat": "Versions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Low Signal Quality Events",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(pyrosense_mvp3_low_signal_quality_total[5m])",
          "legendFormat": "Low Signal/s"
        },
        {
          "expr": "rate(pyrosense_mvp3_clock_drift_total[5m])",
          "legendFormat": "Clock Drift/s"
        }
      ]
    },
    {
      "title": "Offline Queue Flush Events",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(pyrosense_mvp3_offline_queue_flush_total[5m])",
          "legendFormat": "Flush/s"
        }
      ]
    },
    {
      "title": "Validation Pipeline Duration (P95)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pyrosense_mvp3_validation_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.50, rate(pyrosense_mvp3_validation_duration_seconds_bucket[5m]))",
          "legendFormat": "P50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 37,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s"
}
