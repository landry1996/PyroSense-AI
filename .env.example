# ============================================================
# PyroSense AI Platform - Environment Variables
# ============================================================
# Copy to .env or .env.docker for local development.
# WARNING: These are EXAMPLE values. Never use in production.
# ============================================================

# --- Database ---
DB_USERNAME=pyrosense
DB_PASSWORD=changeme
POSTGRES_USER=pyrosense
POSTGRES_PASSWORD=changeme

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MQTT ---
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_ENABLED=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_ISSUER=http://localhost:8180/realms/pyrosense
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Observability ---
GRAFANA_PASSWORD=changeme
TRACING_SAMPLING=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Service URLs (for Docker internal network, override in .env.docker) ---
IDENTITY_SERVICE_URL=http://localhost:8081
DEVICE_SERVICE_URL=http://localhost:8082
INGESTION_SERVICE_URL=http://localhost:8083
ANALYSIS_SERVICE_URL=http://localhost:8084
SCORING_SERVICE_URL=http://localhost:8085
ALERTING_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
DASHBOARD_SERVICE_URL=http://localhost:8088
REPORTING_SERVICE_URL=http://localhost:8091
MAINTENANCE_SERVICE_URL=http://localhost:8089

# --- Java (Docker only) ---
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
