# ============================================================
# PyroSense Local Docker Development Environment
# ============================================================
# WARNING: These are LOCAL DEVELOPMENT defaults only.
# NEVER use these values in production.
# Copy this file to .env and customize as needed.
# ============================================================

# --- Database ---
DB_USERNAME=pyrosense
DB_PASSWORD=pyrosense_local_dev
POSTGRES_USER=pyrosense
POSTGRES_PASSWORD=pyrosense_local_dev

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MQTT ---
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_ENABLED=true

# --- Keycloak ---
KEYCLOAK_ISSUER=http://keycloak:8080/realms/pyrosense
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Observability ---
GRAFANA_PASSWORD=admin_local_dev
TRACING_SAMPLING=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Service URLs (internal Docker network) ---
IDENTITY_SERVICE_URL=http://identity-service:8081
DEVICE_SERVICE_URL=http://device-service:8082
INGESTION_SERVICE_URL=http://ingestion-service:8083
ANALYSIS_SERVICE_URL=http://analysis-service:8084
SCORING_SERVICE_URL=http://scoring-service:8085
ALERTING_SERVICE_URL=http://alerting-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8087
REPORTING_SERVICE_URL=http://reporting-service:8091
MAINTENANCE_SERVICE_URL=http://maintenance-service:8089

# --- Java ---
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
